---
import { getEntryBySlug } from "astro:content";
import ResponsiveImage from "@shared/components/ResponsiveImage.astro";

type Props = { slug: string };
const { slug } = Astro.props as Props;

const itemDescription = await getEntryBySlug("itemDescriptions", slug);

const { Content } = itemDescription
  ? await itemDescription.render()
  : { Content: null };
---

{
  Content !== null && (
    <div class="prose-sm">
      <Content components={{ img: ResponsiveImage }} />
    </div>
  )
}

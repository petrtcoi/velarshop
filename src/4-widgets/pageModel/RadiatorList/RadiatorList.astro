---
import RadiatorsList from "./components/RadiatorsList";
import { sortStringsAsInts } from "@shared/utils/sortStringsAsInts";
import { pickRadiatorListFields } from "./utils/pickRadiatorListFields";
import { getModelFilters } from "./utils/getModelFilters";

import { radiatorsJsonData } from "@entities/Radiator";
import { modelsJsonData } from "@entities/Model";
import { getModelSlug } from "@shared/utils/getModelSlug";

import type { ModelJson } from "@entities/Model";

type Props = {
  model: ModelJson;
};
const { model } = Astro.props as Props;

const radiators = radiatorsJsonData.filter((r) => r.model_id === model.id);
const heights = [...new Set(radiators.map((r) => r.height))].sort(
  sortStringsAsInts
);
const widths = [...new Set(radiators.map((r) => r.width))].sort(
  sortStringsAsInts
);
const lengths = [...new Set(radiators.map((r) => r.length))].sort(
  sortStringsAsInts
);
const interAxes = [
  ...new Set(
    radiators
      .map((r) => r.n_spacing)
      .filter((value): value is string => Boolean(value))
  ),
].sort(sortStringsAsInts);

const { filterByHeight, filterByWidth, filterByLength } =
  getModelFilters(model);

// Трубчатые: модель той же высоты с числом трубок на одну больше (3057 -> 4057) для подсказки «Сколько секций нужно».
const moreTubesModelSource =
  model.type === "columns" && /^\d/.test(model.id)
    ? modelsJsonData.find(
        (item) =>
          item.type === "columns" &&
          item.id === `${Number.parseInt(model.id[0], 10) + 1}${model.id.slice(1)}`
      )
    : undefined;
const moreTubesMaxPower = moreTubesModelSource
  ? Math.max(
      0,
      ...radiatorsJsonData
        .filter((r) => r.model_id === moreTubesModelSource.id)
        .map((r) => Number.parseFloat(r.dt60 || "0") || 0)
    )
  : 0;
const moreTubesModel = moreTubesModelSource
  ? {
      name: moreTubesModelSource.name,
      href: getModelSlug(moreTubesModelSource),
      maxPowerDt60: moreTubesMaxPower,
    }
  : null;

// В остров уходят только поля, которые читает список; начальный отфильтрованный список RadiatorsList считает сам.
const radiatorListItems = radiators.map(pickRadiatorListFields);
---

<RadiatorsList
  client:load
  model={model}
  radiators={radiatorListItems}
  filterByHeight={filterByHeight}
  filterByWidth={filterByWidth}
  filterByLength={filterByLength}
  heights={heights}
  widths={widths}
  lengths={lengths}
  interAxes={interAxes}
  moreTubesModel={moreTubesModel}
/>

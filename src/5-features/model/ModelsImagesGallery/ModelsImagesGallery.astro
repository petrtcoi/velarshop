---
import Picture from '@shared/components/Picture.astro';
import type { ModelJson } from '@entities/Model';
import { getModelFolderImages } from '../../../lib/modelImages';

type Props = {
  title: string;
  ignoreMain?: boolean;
  model: ModelJson;
};
const { ignoreMain = true, model, title } = Astro.props as Props;

// Photos are served from /public by path (AVIF/WebP variants via the image manifest).
const folder = model.type === 'columns' ? 'columns' : model.id; // TODO remove columns type hack
const images = getModelFolderImages(folder).filter(image => {
  const fileName = image.src.split('/').at(-1) ?? '';
  return !(ignoreMain === true && fileName.includes('main'));
});

//TODO: Add show / hide images toggle link or button
---

{
  images.length !== 0 && (
    <div>
      <h2 class="mt-14 mb-1">{title}</h2>
      <div class="mb-4 font-thin text-xs">
        Обращаем ваше внимание на то, что реальный внешний вид может отличаться
        от изображений на экране.
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 max-w-6xl mx-auto">
        {images.map(image => (
          <div class="mx-auto">
            <Picture
              src={image.src}
              alt={`${model.prefix} Velar ${model.name}`}
              title={`${model.prefix} Velar ${model.name}`}
              width={400}
              height={image.width && image.height ? Math.round(400 * (image.height / image.width)) : undefined}
              sizes="(max-width: 639px) calc(100vw - 24px), 400px"
              loading="lazy"
            />
          </div>
        ))}
      </div>
    </div>
  )
}

---
import { formatRub, type DesignOrientation, type DesignSeries } from './designData'

type Props = { series: DesignSeries[]; orientation: DesignOrientation }
const { series, orientation } = Astro.props as Props
const isVertical = orientation === 'vertical'
const textLinkClass = 'text-red-700 underline decoration-red-300 underline-offset-2 transition hover:decoration-transparent'
---

<section id='design-orientation-dimensions' class='bg-white py-10 md:py-16'>
	<div class='mx-auto max-w-[1240px] px-4 md:px-6 xl:px-8'>
		<h2 class='text-2xl font-semibold leading-tight text-neutral-950 md:text-3xl'>Размеры, мощность и цены {isVertical ? 'вертикальных' : 'горизонтальных'} моделей</h2>
		<p class='mt-4 max-w-3xl text-sm font-normal leading-6 text-neutral-700 md:text-base'>
			Диапазоны относятся к {isVertical ? 'вертикальным' : 'горизонтальным'} исполнениям каждой модели. Мощность указана при ΔT70; для другого температурного режима нужен пересчет. Цена «от» относится к минимальной конфигурации, стоимость выбранного размера смотрите на странице модели.
		</p>
		<div class='mt-6 overflow-x-auto'>
			<table class='w-full min-w-[760px] border-collapse text-left text-sm'>
				<thead><tr class='border-y border-neutral-200 text-neutral-600'>
					{['Модель', 'Высота', 'Длина вдоль стены', 'Глубина', 'Мощность при ΔT70', 'Подключение', 'Цена от'].map(label => <th scope='col' class='px-3 py-3 font-medium'>{label}</th>)}
				</tr></thead>
				<tbody>{series.map(item => {
					const model = item.models[0]
					return <tr class='border-b border-neutral-200'>
						<th scope='row' class='px-3 py-4 font-medium'><a href={`${model.href}#model-variants`} class={textLinkClass}>{model.title}</a></th>
						<td class='px-3 py-4'>{model.heightLabel}</td><td class='px-3 py-4'>{model.lengthLabel}</td><td class='px-3 py-4'>{model.depthLabel}</td>
						<td class='px-3 py-4'>{model.powerLabel}</td><td class='px-3 py-4'>{model.connectionLabel}</td><td class='whitespace-nowrap px-3 py-4'>{formatRub(model.priceFrom)}</td>
					</tr>
				})}</tbody>
			</table>
		</div>
		<p class='mt-5 max-w-3xl text-sm leading-6 text-neutral-700'>
			{isVertical ? 'Перед заказом измерьте свободный простенок и оставьте место для арматуры и монтажных зазоров. ' : 'Для установки под окно проверьте расстояние от пола до подоконника, длину ниши и положение труб. '}
			<a href='/info/kak-podobrat-dizayn-radiator-pod-gotovye-vyvody-trub' class={textLinkClass}>Как подобрать модель под готовые выводы</a>.
			{isVertical && <> Высокие модели сравните в <a href='/collections/verticalnye-radiatory-1800-mm' class={textLinkClass}>подборке радиаторов около 1800 мм</a>.</>}
		</p>
	</div>
</section>

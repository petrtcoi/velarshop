---
import { comparisonRoom, roomRadiatorComparison } from '../../lib/roomRadiatorComparison'
import { formatSections } from '../../lib/productFormat'

interface Props { reducedTemperature?: boolean }
const { reducedTemperature = false } = Astro.props
const rows = roomRadiatorComparison()
const rub = (price: number) => `${Math.round(price).toLocaleString('ru-RU')} ₽`
const cheapest = [...rows].sort((a, b) => a.price - b.price)[0]
---
<div class='my-6 overflow-x-auto' data-room-comparison={reducedTemperature ? 'delta-t-50' : 'delta-t-70'}>
	<table class='w-full min-w-[680px] border-collapse text-left text-sm'>
		<thead><tr class='border-y border-neutral-200'>
			{(reducedTemperature
				? ['Исполнение', 'Мощность при ΔT70', 'Пересчет при ΔT50', 'Потребность комнаты']
				: ['Модель', 'Секции', 'Высота × ширина', 'Вылет от стены по схеме', 'Мощность при ΔT70', 'Цена прибора'])
				.map(label => <th scope='col' class='px-3 py-3 font-medium'>{label}</th>)}
		</tr></thead>
		<tbody>{rows.map(row => <tr class='border-b border-neutral-200'>
			<th scope='row' class='px-3 py-4 font-medium'><a href={`${row.href}#model-variants`}>Velar {row.model.name}</a>{reducedTemperature && <span class='block font-normal'>{formatSections(row.sections)}, 1750 мм</span>}</th>
			{reducedTemperature ? <>
				<td class='whitespace-nowrap px-3 py-4'>{row.power.toLocaleString('ru-RU')} Вт</td>
				<td class='whitespace-nowrap px-3 py-4'>{row.powerAt50.toLocaleString('ru-RU')} Вт</td>
				<td class='whitespace-nowrap px-3 py-4'>{comparisonRoom.heatLoad.toLocaleString('ru-RU')} Вт</td>
			</> : <>
				<td class='px-3 py-4'>{formatSections(row.sections)}</td>
				<td class='whitespace-nowrap px-3 py-4'>1750 × {row.length} мм</td>
				<td class='whitespace-nowrap px-3 py-4'>{row.projection} мм{row.modelId === 'r32v' ? '*' : ''}</td>
				<td class='whitespace-nowrap px-3 py-4'>{row.power.toLocaleString('ru-RU')} Вт</td>
				<td class='whitespace-nowrap px-3 py-4'>{rub(row.price)}</td>
			</>}
		</tr>)}</tbody>
	</table>
</div>
{reducedTemperature ? <p class='text-sm leading-6 text-neutral-600'>Пересчет по формуле паспортов трех серий с n = 1,30. {rows.every(row => row.powerAt50 < comparisonRoom.heatLoad) ? 'При ΔT50 ни одно из этих исполнений не покрывает условные 1500 Вт: нужно заново подобрать число секций.' : 'Сопоставьте пересчитанную мощность с потребностью комнаты и при необходимости измените число секций.'}</p> : <>
	<p class='text-sm leading-6 text-neutral-600'>Цена выбранного прибора из действующего каталога. Арматура, специальные покрытия, дополнительные опоры, доставка и монтаж в этой сумме не объявлены включенными. В этом наборе минимальная базовая цена — у Velar {cheapest.model.name}: {rub(cheapest.price)}.</p>
	<p class='text-sm leading-6 text-neutral-600'>* Для R32V в каталоге и монтажной схеме указан вылет 61 мм, а в таблице паспорта — глубина 62 мм. Перед монтажом подтвердите габарит конкретного исполнения; не проектируйте нишу по одному округленному числу.</p>
</>}

---
type Variant = 'default' | 'light' | 'accent'

type Props = {
	title: string
	description?: string
	buttonText?: string
	buttonHref?: string
	linkText?: string
	linkHref?: string
	variant?: Variant
	size?: 'default' | 'compact'
	class?: string
	className?: string
	/** Место CTA для цели Метрики article_cta_click: 'inline' (в тексте статьи) или 'footer' (в конце). */
	trackPlace?: 'inline' | 'footer'
}

const {
	title,
	description,
	buttonText = 'Получить расчет',
	buttonHref = '/request',
	linkText,
	linkHref,
	variant = 'default',
	size = 'default',
	class: classAttr = '',
	className = '',
	trackPlace = 'inline',
} = Astro.props as Props

const variantClass =
	variant === 'accent'
		? 'article-cta--accent'
		: variant === 'light'
			? 'article-cta--light'
			: 'article-cta--default'

const sizeClass = size === 'compact' ? 'article-cta--compact' : ''

// На страницах статей /info/<slug> кнопка на форму получает ?from=<slug> (LeadWidget допишет статью в комментарий)
// и отправляет цель Метрики article_cta_click. Скрипт цели подключен в src/pages/info/[article].astro.
const articleSlug = Astro.url.pathname.match(/^\/info\/([a-z0-9-]+)\/?$/)?.[1]
const resolvedButtonHref =
	articleSlug && buttonHref === '/request' ? `/request?from=${encodeURIComponent(articleSlug)}` : buttonHref
const trackAttrs = articleSlug
	? { 'data-article-goal': 'article_cta_click', 'data-article-slug': articleSlug, 'data-article-place': trackPlace }
	: {}
---

<aside class:list={['not-prose article-cta', variantClass, sizeClass, classAttr, className]}>
	<div class='article-cta__content'>
		<h2 class='article-cta__title'>{title}</h2>
		{description && <p class='article-cta__description'>{description}</p>}
	</div>

	<div class='article-cta__actions'>
		<a class='article-cta__button' href={resolvedButtonHref} {...trackAttrs}>{buttonText}</a>
		{linkText && linkHref && <a class='article-cta__link' href={linkHref}>{linkText}</a>}
	</div>
</aside>

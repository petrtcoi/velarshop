---
import Layout from '@shared/layouts/Layout.astro'
import Picture from '@shared/components/Picture.astro'
import JsonLd from '../../components/seo/JsonLd.astro'
import { collectionGroups, featuredCollections } from '../../lib/featuredCollections'
import { getCategorySeo } from '../../lib/seo/categorySeo'

const breadcrumbs = [
	{ title: 'Главная', url: '/' },
	{ title: 'Подборки', url: '/collections' },
]

const seo = getCategorySeo({
	category: {
		slug: 'collections',
		url: '/collections',
		name: 'Подборки',
		h1: 'Подборки радиаторов Velar',
		seoTitle: 'Подборки радиаторов по высоте, размерам и типу - Velar',
		seoDescription:
			'Подборки радиаторов Velar по межосевому расстоянию, полной высоте, числу труб и типу конвекции. Сравнение моделей, размеров, мощности и цен.',
		ogTitle: 'Подборки радиаторов Velar',
		ogDescription:
			'Радиаторы Velar, сгруппированные по межосевому расстоянию, полной высоте, числу труб и типу конвекции.',
		ogImage: '/images/models/columns/vertical.jpg',
		ogImageAlt: 'Подборки радиаторов Velar',
		breadcrumbs,
		itemListName: 'Подборки радиаторов Velar',
		products: featuredCollections.map(item => ({
			name: item.title,
			url: item.href,
		})),
	},
})
---

<Layout
	title={seo.title}
	description={seo.description}
	canonicalUrl={seo.canonicalUrl}
	robots={seo.robots}
	ogType='website'
	ogTitle={seo.ogTitle}
	ogDescription={seo.ogDescription}
	ogUrl={seo.canonicalUrl}
	ogImageUrl={seo.ogImage}
	ogImageAlt={seo.ogImageAlt}
	twitterCard='summary_large_image'
	twitterTitle={seo.twitterTitle}
	twitterDescription={seo.twitterDescription}
	twitterImage={seo.twitterImage}
	twitterImageAlt={seo.twitterImageAlt}
	breadcrumbs={breadcrumbs}
	disableBreadcrumbJsonLd={true}
	paddings={false}
>
	<JsonLd data={seo.jsonLd} />

	<section class='border-b border-neutral-200 bg-white py-10 md:py-14 xl:py-16'>
		<div class='mx-auto max-w-[1180px] px-4 md:px-6 xl:px-8'>
			<p class='text-xs font-medium uppercase tracking-[0.12em] text-red-700'>Каталог по параметрам</p>
			<h1 class='mt-3 max-w-4xl text-3xl font-semibold leading-tight tracking-tight text-neutral-950 md:text-5xl'>
				Подборки радиаторов Velar
			</h1>
			<p class='mt-5 max-w-3xl text-sm font-normal leading-6 text-neutral-700 md:text-base md:leading-7'>
				Здесь модели сгруппированы по параметрам, которые действительно важны при монтаже.
				Если трубы уже выведены, начинайте с межосевого расстояния. Если место еще можно
				спланировать — выбирайте по полной высоте, числу труб или типу конвекции.
			</p>
		</div>
	</section>

	<div class='bg-white'>
		{collectionGroups.map((group, groupIndex) => (
			<section
				id={group.id}
				class:list={[
					'py-10 md:py-14 xl:py-16',
					groupIndex > 0 && 'border-t border-neutral-200',
				]}
			>
				<div class='mx-auto max-w-[1180px] px-4 md:px-6 xl:px-8'>
					<div class='grid gap-4 md:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] md:gap-10'>
						<h2 class='text-2xl font-semibold leading-tight tracking-tight text-neutral-950 md:text-3xl'>
							{group.title}
						</h2>
						<div>
							<p class='max-w-2xl text-sm font-normal leading-6 text-neutral-700 md:text-base md:leading-7'>
								{group.description}
							</p>
							{group.href && group.linkLabel && (
								<a
									href={group.href}
									class='mt-3 inline-flex text-sm font-medium text-red-700 underline decoration-red-300 underline-offset-4 transition hover:decoration-transparent'
								>
									{group.linkLabel}
								</a>
							)}
						</div>
					</div>

					<div class='mt-8 border-y border-neutral-200 md:mt-10'>
						{group.items.map((item, index) => (
							<article class:list={['py-5 md:py-6', index > 0 && 'border-t border-neutral-200']}>
								<a
									href={item.href}
									class='group grid gap-5 sm:grid-cols-[112px_minmax(0,1fr)] md:grid-cols-[128px_minmax(0,1fr)_auto] md:items-center md:gap-7'
								>
									<div class='flex h-28 w-28 items-center justify-center bg-neutral-50 p-3 md:h-32 md:w-32'>
										<Picture
											src={item.image}
											alt={item.imageAlt}
											title={item.title}
											loading='lazy'
											width={128}
											height={128}
											sizes='(max-width: 767px) 112px, 128px'
											class='h-full w-full object-contain'
										/>
									</div>

									<div class='min-w-0'>
										<h3 class='text-lg font-semibold leading-tight text-neutral-950 transition group-hover:text-red-700 md:text-xl'>
											{item.title}
										</h3>
										<p class='mt-2 max-w-2xl text-sm font-normal leading-6 text-neutral-600'>
											{item.description}
										</p>
										<ul class='mt-3 flex flex-wrap gap-x-5 gap-y-1 text-sm leading-5 text-neutral-500'>
											{item.facts.map(fact => (
												<li>{fact}</li>
											))}
										</ul>
									</div>

									<span class='inline-flex items-center gap-2 text-sm font-medium text-neutral-950 md:justify-self-end'>
										Смотреть подборку
										<span aria-hidden='true' class='text-red-700 transition-transform group-hover:translate-x-1'>→</span>
									</span>
								</a>
							</article>
						))}
					</div>
				</div>
			</section>
		))}
	</div>

	<section class='border-t border-neutral-200 bg-neutral-50 py-10 md:py-14 xl:py-16'>
		<div class='mx-auto max-w-[1180px] px-4 md:px-6 xl:px-8'>
			<div class='grid gap-8 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-12'>
				<div>
					<h2 class='text-2xl font-semibold leading-tight tracking-tight text-neutral-950 md:text-3xl'>
						Не уверены, с чего начать
					</h2>
					<p class='mt-4 max-w-xl text-sm font-normal leading-6 text-neutral-700 md:text-base md:leading-7'>
						Пришлите фото места установки, расстояние между центрами выводов и размеры стены.
						Мы проверим геометрию, рассчитаем мощность и предложим подходящие модели.
					</p>
					<div class='mt-6 flex flex-col gap-3 min-[420px]:flex-row min-[420px]:flex-wrap'>
						<a href='/request' class='inline-flex h-11 items-center justify-center rounded-lg bg-red-700 px-5 text-sm font-semibold text-white transition hover:bg-red-800'>
							Получить расчет
						</a>
						<a href='/delivery' class='inline-flex h-11 items-center justify-center rounded-lg border border-neutral-300 bg-white px-5 text-sm font-medium text-neutral-950 transition hover:border-neutral-950'>
							Доставка и оплата
						</a>
					</div>
				</div>

				<ol class='border-y border-neutral-200'>
					{[
						['Измерьте выводы', 'Расстояние считают от центра одной трубы до центра другой.'],
						['Выберите подборку', 'Сравните модели с подходящей монтажной геометрией.'],
						['Проверьте мощность', 'Финальный размер радиатора зависит от теплопотерь помещения.'],
					].map(([title, description], index) => (
						<li class:list={['grid grid-cols-[40px_1fr] gap-3 py-4', index > 0 && 'border-t border-neutral-200']}>
							<span class='text-sm font-medium text-red-700'>0{index + 1}</span>
							<div>
								<h3 class='text-base font-semibold text-neutral-950'>{title}</h3>
								<p class='mt-1 text-sm font-normal leading-6 text-neutral-600'>{description}</p>
							</div>
						</li>
					))}
				</ol>
			</div>
		</div>
	</section>
</Layout>

---
import Layout from '@shared/layouts/Layout.astro'
import JsonLd from '../components/seo/JsonLd.astro'
import OrderScope from '../components/product/OrderScope.astro'
import ConfigurationExamples from '../components/product/ConfigurationExamples.astro'

import ColumnsCatalog from '../components/columns/ColumnsCatalog.astro'
import ColumnsComparison from '../components/columns/ColumnsComparison.astro'
import ColumnsCalculator from '../components/columns/ColumnsCalculator.astro'
import ColumnsFaq from '../components/columns/ColumnsFaq.astro'
import ColumnsHero from '../components/columns/ColumnsHero.astro'
import ColumnsHowToOrderShort from '../components/columns/ColumnsHowToOrderShort.astro'
import ColumnsInteriors from '../components/columns/ColumnsInteriors.astro'
import PopularModels from '../components/columns/PopularModels.astro'
import ColumnsTaskSelector from '../components/columns/ColumnsTaskSelector.astro'
import ColumnsTubeDifferences from '../components/columns/ColumnsTubeDifferences.astro'
import ColumnsUseCases from '../components/columns/ColumnsUseCases.astro'
import ColumnsWhatIs from '../components/columns/ColumnsWhatIs.astro'
import ColumnsWhoFits from '../components/columns/ColumnsWhoFits.astro'
import ColumnsWhyVelar from '../components/columns/ColumnsWhyVelar.astro'
import UsefulArticles from '../components/columns/UsefulArticles.astro'
import {
	columnsFaqItems,
	columnsModels,
	minCatalogPrice,
	popularModels,
	usefulArticleGroups,
} from '../components/columns/columnsData'
import { getCategorySeo } from '../lib/seo/categorySeo'

const contents = [
  { id: 'columns-configurator', label: 'Быстрый подбор', major: true, description: 'Модель, размеры, подключение и цвет' },
  { id: 'columns-models', label: 'Каталог моделей', major: true, description: 'Модели по высоте, числу труб и теплоотдаче' },
  { id: 'columns-popular', label: 'Популярные модели', major: true, description: 'Низкие, стандартные и высокие модели' },
  { id: 'columns-price-examples', label: 'Примеры цен', major: true, description: 'Готовые конфигурации на 10 секций' },
  { id: 'order-scope', label: 'Что входит в стоимость', major: true, description: 'Комплектация и согласование перед заказом' },
  { id: 'columns-calculator', label: 'Подбор по параметрам', major: true, description: 'Расчет радиатора по параметрам' },
  { id: 'columns-task-selector', label: 'Выбор по задаче', major: true, description: 'Подходящие модели для разных ситуаций' },
  { id: 'columns-how-order-short', label: 'Как заказать' },
  { id: 'columns-tube-differences', label: 'Различия моделей' },
  { id: 'columns-who-fits', label: 'Кому подходят' },
  { id: 'columns-interiors', label: 'В интерьере' },
  { id: 'columns-what-is', label: 'О трубчатых радиаторах' },
  { id: 'columns-comparison', label: 'Сравнение радиаторов' },
  { id: 'columns-use-cases', label: 'Где подходят' },
  { id: 'columns-why-velar', label: 'Почему Velar' },
  { id: 'columns-faq', label: 'Вопросы и ответы' },
  { id: 'columns-useful-articles', label: 'Полезные материалы' },
]

const breadcrumbs = [
	{ title: 'Главная', url: '/' },
	{ title: 'Трубчатые радиаторы', url: '/columns' },
]

const priceFromLabel = `${minCatalogPrice.toLocaleString('ru-RU').replace(/\s/g, '\u00a0')}\u00a0₽`

const seo = getCategorySeo({
	category: {
		slug: 'columns',
		url: '/columns',
		name: 'Трубчатые радиаторы',
		h1: 'Трубчатые радиаторы отопления',
		seoTitle: `Трубчатые радиаторы отопления: цены от ${priceFromLabel}, купить Velar`,
		seoDescription:
			`Стальные трубчатые радиаторы отопления Velar от ${priceFromLabel} за радиатор: 2-, 3- и 4-трубчатые модели, высота, секции и мощность, цвета RAL, боковое и нижнее подключение.`,
		ogTitle: 'Трубчатые радиаторы - каталог моделей и цены',
		ogDescription:
			'Стальные трубчатые радиаторы Velar разных высот и секционности. Подбор мощности, цвета RAL и доставка по России.',
		ogImage: '/images/models/columns/hero-black-column-radiator.png',
		ogImageAlt: 'Стальные трубчатые радиаторы Velar',
		breadcrumbs,
		itemListName: 'Модели трубчатых радиаторов Velar',
		products: columnsModels.map(model => ({
			name: `Velar ${model.name}`,
			url: model.href,
		})),
		faq: columnsFaqItems.map(item => ({
			question: item.question,
			answer: item.answer,
		})),
	},
})

---

<Layout
	title={seo.title}
	description={seo.description}
	canonicalUrl={seo.canonicalUrl}
	robots={seo.robots}
	ogType='website'
	ogTitle={seo.ogTitle}
	ogDescription={seo.ogDescription}
	ogUrl={seo.canonicalUrl}
	ogImageUrl={seo.ogImage}
	ogImageAlt={seo.ogImageAlt}
	twitterCard='summary_large_image'
	twitterTitle={seo.twitterTitle}
	twitterDescription={seo.twitterDescription}
	twitterImage={seo.twitterImage}
	twitterImageAlt={seo.twitterImageAlt}
	paddings={false}
	breadcrumbs={breadcrumbs}
	disableBreadcrumbJsonLd={true}
>
	<JsonLd data={seo.jsonLd} />

	<ColumnsHero items={contents} />

	{/* 24.11.2026: фильтр моделей сразу после первого экрана; подборки (/collections/*) встроены в него */}
	<ColumnsCatalog models={columnsModels} />

	<PopularModels models={popularModels} />
	<ConfigurationExamples
		id='columns-price-examples'
		title='Цены трубчатых радиаторов в готовых размерах'
		intro='Сравните четыре конфигурации на 10 секций: низкую 3030, модели 2057 и 3057 с межосевым расстоянием 500 мм и высокую 2180. Цена относится ко всему радиатору с указанными размерами, а не к одной секции. Подходящее число секций определяют по теплопотерям помещения.'
		modelIds={['3030', '2057', '3057', '2180']}
	/>

	<OrderScope />

	<ColumnsCalculator />

	<ColumnsTaskSelector variant='expanded' />

	<ColumnsHowToOrderShort />

	<ColumnsTubeDifferences />

	<ColumnsWhoFits />

	<ColumnsInteriors />

	<ColumnsWhatIs />

	<ColumnsComparison />

	<ColumnsUseCases />

	<ColumnsWhyVelar />

	<ColumnsFaq />

	<UsefulArticles groups={usefulArticleGroups} />
</Layout>
